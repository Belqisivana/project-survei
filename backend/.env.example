# Ganti dengan koneksi PostgreSQL kamu. Untuk dev cepat, boleh pakai SQLite (lihat komentar di config.py)
DATABASE_URL=postgresql://user:password@localhost:5432/review_funnel

# Rating minimum yang wajib dicapai sebelum diarahkan ke Google Maps
MIN_RATING_THRESHOLD=4

# Untuk CORS, alamat frontend Next.js kamu
FRONTEND_ORIGIN=http://localhost:3000
